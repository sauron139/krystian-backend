# Copy to .env for running outside Docker. In Docker, krystian-infra provides these.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://krystian:krystian@localhost:5432/krystian
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:4321","http://localhost:5173"]
SECRET_KEY=dev-insecure-secret-change-me
# Email: Mailpit catches everything locally (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
NOTIFY_EMAIL=owner@krystian.dev
# Local admin created on startup in development only
DEV_ADMIN_EMAIL=admin@krystian.dev
DEV_ADMIN_PASSWORD=change-me-locally
